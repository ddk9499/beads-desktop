// Single source of truth for the app's identity.
// Rename the app by changing APP_DISPLAY_NAME only; data paths are keyed by the bundle id.
APP_DISPLAY_NAME = BeadsDesktop
PRODUCT_NAME = $(APP_DISPLAY_NAME)
PRODUCT_BUNDLE_IDENTIFIER = uz.dkamaloff.beads
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Two latest macOS majors (26, 27). Bump yearly after a new macOS ships.
MACOSX_DEPLOYMENT_TARGET = 26.0
ARCHS = arm64
SWIFT_VERSION = 6.0

GENERATE_INFOPLIST_FILE = YES
// Icon Composer file Resources/Icon/AppIcon.icon (layers: beads, headers, columns; concept "Bead Board").
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.developer-tools
INFOPLIST_KEY_NSHumanReadableCopyright =

// ~/.ssh and the ssh-agent socket are unreachable from App Sandbox -> Developer ID distribution.
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_STYLE = Automatic
// Ad-hoc by default. A stable identity (Apple Development) is needed for notifications to be allowed:
// put DEVELOPMENT_TEAM / CODE_SIGN_IDENTITY into Config/Signing.xcconfig (gitignored, see Signing.example.xcconfig).
CODE_SIGN_IDENTITY = -
#include? "Signing.xcconfig"
ENABLE_USER_SCRIPT_SANDBOXING = NO
